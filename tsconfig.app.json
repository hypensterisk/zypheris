{
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "module": "preserve",
    "paths": {
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@fields/*": ["./src/fields/*"]
    },

    "types": ["vite/client"],
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "extends": "./tsconfig.base.json",
  "include": ["src/**/*"]
}
